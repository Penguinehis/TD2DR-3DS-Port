; Level tiles (sprite.c tile batcher): screen position and texture coordinate, projected like citro2d.
.fvec projection[4]

.constf consts(0.0, 1.0, 0.0, 0.0)
.alias ones consts.yyyy

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intc v1

.proc main
	mov r0.xy, inpos.xy
	mov r0.z, consts.x
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc0, intc
	end
.end
