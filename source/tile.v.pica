; Sprite and tile quads (sprite.c batcher): screen position, texture coordinate and colour,
; projected like citro2d. The colour multiplies the texture (GameMaker image_blend + alpha).
.fvec projection[4]

.constf consts(0.0, 1.0, 0.0039215686, 0.0)
.alias zero consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc v1
.alias inclr v2

.proc main
	mov r0.xy, inpos.xy
	mov r0.z, zero
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc0, intc
	mul outclr, inv255, inclr
	end
.end
